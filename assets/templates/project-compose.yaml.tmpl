# Generated by lodev on every `lodev start` — edit .lodev/config.yaml instead.
name: lodev-{{.P.Name}}

networks:
  lodev:
    external: true

services:
  web:
    image: {{.Image}}
    container_name: lodev-{{.P.Name}}-web
    hostname: {{.P.Name}}-web
    restart: unless-stopped
{{- if .P.Varnish}}
    # Varnish waits for this: a backend that refuses its first probe starts sick (503s).
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/80"]
      interval: 2s
      retries: 30
{{- end}}
    environment:
      - LODEV_PHP={{.P.PHP}}
      - LODEV_WEBSERVER={{.P.Webserver}}
      - LODEV_USER={{.User}}
      - LODEV_UID={{.UID}}
      - LODEV_GID={{.GID}}
      - PHP_IDE_CONFIG=serverName={{.P.Name}}
      - DB_HOST={{or .P.DB "mysql"}}
      - DB_PORT=3306
      - DB_DATABASE={{.P.DBName}}
      - DB_USERNAME=root
      - DB_PASSWORD=root
      - REDIS_HOST=redis
      - OPENSEARCH_HOST=opensearch
      - MONGODB_URI=mongodb://root:root@mongodb:27017/?authSource=admin
      - MAIL_HOST=mailpit
      - MAIL_PORT=1025
{{- if .P.Varnish}}
      - VARNISH_HOST=lodev-{{.P.Name}}-varnish
{{- end}}
    networks: [lodev, default]
    extra_hosts:
{{- range .ExtraHosts}}
      - "{{.}}:172.30.0.2"
{{- end}}
    volumes:
      - {{q (print .P.Root ":/var/www/html")}}
      - {{q (print .CAFile ":/etc/lodev/rootCA.pem:ro")}}
      - {{q (print .P.Root "/.lodev/php:/etc/lodev/php.d:ro")}}
      - {{q (print .HomeDir ":/home/" .User)}}
{{- if ne .P.Webserver "none"}}
      - {{q (print .P.Root "/.lodev/" .P.Webserver "-webserver.conf:/etc/lodev/webserver.conf:ro")}}
      - {{q (print .P.Root "/.lodev/" .P.Webserver ":" (index .CustomDir .P.Webserver) ":ro")}}
{{- if not .P.Varnish}}
    labels:
      - traefik.enable=true
      - "traefik.http.routers.p-{{.P.Name}}.rule={{.Rule}}"
      - traefik.http.routers.p-{{.P.Name}}.entrypoints=websecure
      - traefik.http.routers.p-{{.P.Name}}.tls=true
      - traefik.http.services.p-{{.P.Name}}.loadbalancer.server.port=80
{{- end}}
{{- end}}
{{- if .P.Varnish}}

  # Traefik → varnish:80 → web:80; the VCL is .lodev/varnish.vcl.
  varnish:
    image: {{.P.VarnishImage}}
    container_name: lodev-{{.P.Name}}-varnish
    hostname: {{.P.Name}}-varnish
    restart: unless-stopped
    depends_on:
      web:
        condition: service_healthy
        # varnishd resolves the backend once: recreate varnish when web is recreated.
        restart: true
    networks: [lodev, default]
    volumes:
      - {{q (print .P.Root "/.lodev/varnish.vcl:/etc/varnish/default.vcl:ro")}}
    labels:
      - traefik.enable=true
      - "traefik.http.routers.p-{{.P.Name}}.rule={{.Rule}}"
      - traefik.http.routers.p-{{.P.Name}}.entrypoints=websecure
      - traefik.http.routers.p-{{.P.Name}}.tls=true
      - traefik.http.services.p-{{.P.Name}}.loadbalancer.server.port=80
{{- end}}
