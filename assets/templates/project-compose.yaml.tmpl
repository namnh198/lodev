# generated by lodev. Do NOT change anything
# Rewritten on every `lodev start`: edit .lodev/config.yaml instead.
name: lodev-{{.P.Name}}

networks:
  lodev:
    external: true
{{- if .Volumes}}

volumes:
{{- range .Volumes}}
  {{.Name}}: {name: {{.Name}}, external: true}
{{- end}}
{{- end}}

services:
  web:
    image: {{.Image}}
    container_name: lodev-{{.P.Name}}-web
    hostname: {{.P.Name}}-web
    # dockerd userns-remap would shift the container user's UID off the host's, so it could
    # not write the bind-mounted project and home; a no-op without remapping.
    userns_mode: host
    # Any user may bind :80/:443 (nginx, apache2 run by hand); scoped to the container's network.
    sysctls:
      net.ipv4.ip_unprivileged_port_start: 0
    restart: unless-stopped
    working_dir: {{q .P.WorkDir}}
    # lodev start waits for this, and varnish too (a backend that fails its first probe starts sick).
    healthcheck:
      test: ["CMD", "/usr/local/bin/lodev-healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    environment:
{{- range .Env}}
      - {{q .}}
{{- end}}
    networks: [lodev, default]
{{- if .ExtraHosts}}
    # Every project's domains reach traefik, so one project can call another over https.
    extra_hosts:
{{- range .ExtraHosts}}
      - "{{.}}:172.30.0.2"
{{- end}}
{{- end}}
    volumes:
      - {{q (print .P.Root ":" .P.WorkDir)}}
{{- range .Volumes}}
      - {{q (print .Name ":" $.P.WorkDir "/" .Dir)}}
{{- end}}
      - {{q (print .CAFile ":/etc/lodev/rootCA.pem:ro")}}
      - {{q (print .P.Root "/.lodev/php:/etc/lodev/php.d:ro")}}
{{- if .Cron}}
      - {{q (print .P.Root "/.lodev/crontab:/etc/lodev/crontab:ro")}}
{{- end}}
{{- if .P.WebExtraDaemons}}
      - {{q (print .P.Root "/.lodev/daemons:/etc/lodev/daemons:ro")}}
{{- end}}
      - {{q (print .HomeDir ":/var/lib/lodev/home")}}
      - {{q (print .GlobalHomeAdditional ":/etc/lodev/homeadditional/global:ro")}}
{{- if .ProjectHomeAdditional}}
      - {{q (print .ProjectHomeAdditional ":/etc/lodev/homeadditional/project:ro")}}
{{- end}}
{{- if .ApacheSnapshot}}
      # A copy made after the trust gate: apache config can run commands (piped logs).
      - {{q (print .ApacheSnapshot "/webserver.conf:/etc/lodev/webserver.conf:ro")}}
      - {{q (print .ApacheSnapshot "/custom.d:" (index .CustomDir .P.Webserver) ":ro")}}
{{- else if ne .P.Webserver "none"}}
      - {{q (print .P.Root "/.lodev/" .P.Webserver "-webserver.conf:/etc/lodev/webserver.conf:ro")}}
      - {{q (print .P.Root "/.lodev/" .P.Webserver ":" (index .CustomDir .P.Webserver) ":ro")}}
{{- end}}
{{- if .P.Varnish}}

  # Traefik → varnish:80 → web:80; the VCL is .lodev/varnish.vcl.
  varnish:
    image: {{.P.VarnishImage}}
    container_name: lodev-{{.P.Name}}-varnish
    hostname: {{.P.Name}}-varnish
    restart: unless-stopped
    depends_on:
      web:
        condition: service_healthy
        # varnishd resolves the backend once: recreate varnish when web is recreated.
        restart: true
    networks: [lodev, default]
    volumes:
      - {{q (print .P.Root "/.lodev/varnish.vcl:/etc/varnish/default.vcl:ro")}}
{{- end}}
