<VirtualHost *:80>
    DocumentRoot {{.Root}}
    DirectoryIndex index.php index.html

    <Directory {{.Root}}>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:fcgi://127.0.0.1:9000"
    </FilesMatch>

    SetEnvIf X-Forwarded-Proto https HTTPS=on

    ErrorLog /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined
</VirtualHost>
