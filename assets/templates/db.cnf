# lodev's MySQL/MariaDB settings, mounted as /etc/mysql/conf.d/zz-lodev.cnf. Edit freely: lodev
# writes this file only when it is missing. Apply with `docker restart lodev-mysql` (or lodev-mariadb).
[mysqld]
sql_mode="STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
# loose-: only MySQL 8.0 has this option; MySQL 8.4+ and MariaDB would refuse to start on it.
loose-default_authentication_plugin=mysql_native_password
max_allowed_packet=500M
wait_timeout=28800
interactive_timeout=28800
# Binary logs: rotate at 100M, keep 10 days. binlog_expire_logs_seconds, not expire_logs_days:
# MySQL 8.4 removed that one and refuses to start on it; MySQL 8.0+ and MariaDB read this one.
binlog_expire_logs_seconds=864000
max_binlog_size=100M
