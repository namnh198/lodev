# Generated by `make packaging` from packaging/homebrew/lodev.rb.tmpl; copy to the namnh198/homebrew-tap repo.
class Lodev < Formula
  desc "DDEV-like local PHP development with shared Docker services"
  homepage "https://github.com/{{.Repo}}"
  license "MIT"
  version "{{.Version}}"

  on_macos do
    on_arm do
      url "https://github.com/{{.Repo}}/releases/download/v{{.Version}}/lodev_{{.Version}}_darwin_arm64.tar.gz"
      sha256 "{{sha "darwin_arm64"}}"
    end
    on_intel do
      url "https://github.com/{{.Repo}}/releases/download/v{{.Version}}/lodev_{{.Version}}_darwin_amd64.tar.gz"
      sha256 "{{sha "darwin_amd64"}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/{{.Repo}}/releases/download/v{{.Version}}/lodev_{{.Version}}_linux_arm64.tar.gz"
      sha256 "{{sha "linux_arm64"}}"
    end
    on_intel do
      url "https://github.com/{{.Repo}}/releases/download/v{{.Version}}/lodev_{{.Version}}_linux_amd64.tar.gz"
      sha256 "{{sha "linux_amd64"}}"
    end
  end

  def install
    bin.install "lodev"
    generate_completions_from_executable(bin/"lodev", "completion")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/lodev version")
  end
end
