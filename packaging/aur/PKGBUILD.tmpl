# Maintainer: namnh198 <me@namhoainguyen.com>
# Generated by `make packaging` from packaging/aur/PKGBUILD.tmpl.
pkgname=lodev-bin
_ver={{.Version}}
pkgver={{pkgver .Version}}
pkgrel=1
pkgdesc="DDEV-like local PHP development with shared Docker services"
arch=('x86_64' 'aarch64')
url="https://github.com/{{.Repo}}"
license=('custom')
provides=('lodev')
conflicts=('lodev')
optdepends=('docker: runs the project and shared service containers')
source_x86_64=("https://github.com/{{.Repo}}/releases/download/v${_ver}/lodev_${_ver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/{{.Repo}}/releases/download/v${_ver}/lodev_${_ver}_linux_arm64.tar.gz")
sha256sums_x86_64=('{{sha "linux_amd64"}}')
sha256sums_aarch64=('{{sha "linux_arm64"}}')

package() {
  cd lodev_${_ver}_linux_*
  install -Dm755 lodev "$pkgdir/usr/bin/lodev"
  install -Dm644 completions/lodev.bash "$pkgdir/usr/share/bash-completion/completions/lodev"
  install -Dm644 completions/_lodev "$pkgdir/usr/share/zsh/site-functions/_lodev"
  install -Dm644 completions/lodev.fish "$pkgdir/usr/share/fish/vendor_completions.d/lodev.fish"
}
