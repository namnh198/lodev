#!/usr/bin/env bash

# Imitation/replacement for `lodev` inside the web container
# Partial functionality

set -eu -o pipefail

printf "You executed 'lodev $*' inside the web container\nbut many LODEV commands are not available.\n"

if [ $# -ge 1 ] && command -v "$1" >/dev/null 2>&1; then
  printf "\nHowever, you may be able to use a command like:\n\n$*\n"
fi
