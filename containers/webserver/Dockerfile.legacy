# check=skip=InvalidDefaultArgInFrom
# BASE has no default on purpose: lodev always passes the base image, and a missing one fails the build.
ARG BASE
FROM ${BASE}
ARG PHP_VERSION
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt/lists,sharing=locked lodev-install-php "$PHP_VERSION"
