# Usage: tablepro
# Description: Open the project's MySQL/MariaDB database in TablePro, macOS only (needs ports.mysql or ports.mariadb)
# Verified against https://docs.tablepro.app/databases/connection-urls and the app's Info.plist (it registers
# mysql:// and mariadb://): open -a TablePro "mysql://user:password@host:port/db?name=...". TablePro asks to confirm
# every URL opened from outside. Its tablepro://import URLs never take a password, so they are not used.
[ "$(uname -s)" = Darwin ] || { echo "tablepro is macOS only"; exit 1; }
[ -n "$LODEV_PROJECT" ] || { echo "not in a lodev project"; exit 1; }
[ -n "$LODEV_DB_TYPE" ] || { echo "$LODEV_PROJECT has no MySQL/MariaDB service"; exit 1; }
if [ -z "$LODEV_DB_PORT" ]; then
  [ "$LODEV_DB_TYPE" = mariadb ] && { n=MariaDB p=3307; } || { n=MySQL p=3306; }
  echo "$n is not reachable from this machine: lodev config-global --$LODEV_DB_TYPE-port=$p, then lodev service start"
  exit 1
fi
url="$LODEV_DB_USER:$LODEV_DB_PASSWORD@$LODEV_DB_HOST:$LODEV_DB_PORT/$LODEV_DB_NAME"
open -a TablePro "$LODEV_DB_TYPE://$url?name=lodev-$LODEV_PROJECT"
