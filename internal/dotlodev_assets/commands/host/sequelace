# Usage: sequelace
# Description: Open the project's MySQL/MariaDB database in Sequel Ace, macOS only (needs ports.mysql or ports.mariadb)
# Verified against https://sequel-ace.com/get-started/connect-via-url.html: open 'mysql://user:password@host:port/db'
# (Sequel Ace documents only the mysql:// scheme, which also serves MariaDB).
[ "$(uname -s)" = Darwin ] || { echo "sequelace is macOS only"; exit 1; }
[ -n "$LODEV_PROJECT" ] || { echo "not in a lodev project"; exit 1; }
[ -n "$LODEV_DB_TYPE" ] || { echo "$LODEV_PROJECT has no MySQL/MariaDB service"; exit 1; }
if [ -z "$LODEV_DB_PORT" ]; then
  [ "$LODEV_DB_TYPE" = mariadb ] && { n=MariaDB p=3307; } || { n=MySQL p=3306; }
  echo "$n is not reachable from this machine: lodev config-global --$LODEV_DB_TYPE-port=$p, then lodev service start"
