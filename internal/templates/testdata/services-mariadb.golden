# Generated by lodev — edit ~/.lodev/config.yaml and run `lodev services up` instead.
name: lodev-services

networks:
  lodev:
    name: lodev
    ipam:
      config:
        - subnet: 172.30.0.0/16
          gateway: 172.30.0.1
          # Dynamic IPs stay out of 172.30.0.x, so traefik's fixed 172.30.0.2 is always free.
          ip_range: 172.30.128.0/17

volumes:
  lodev-mysql:
    name: lodev-mysql
  lodev-opensearch:
    name: lodev-opensearch
  lodev-redis:
    name: lodev-redis
  lodev-rabbitmq:
    name: lodev-rabbitmq
  lodev-mariadb:
    name: lodev-mariadb
  lodev-mongodb:
    name: lodev-mongodb
  # mongo also declares /data/configdb a volume; unnamed it would leave a new volume on every re-create.
  lodev-mongodb-config:
    name: lodev-mongodb-config

services:
  traefik:
    image: traefik:v3
    container_name: lodev-traefik
    restart: unless-stopped
    command:
      - --api.insecure=true
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network=lodev
      - --providers.file.filename=/certs/dynamic.yaml
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
    ports:
      - "127.0.0.1:80:80"
      - "127.0.0.1:443:443"
      - "127.0.0.1:8080:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - "/home/u/.lodev/certs:/certs:ro"
    networks:
      lodev:
        ipv4_address: 172.30.0.2

  mysql:
    image: mysql:8.0
    container_name: lodev-mysql
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=root
    volumes:
      - lodev-mysql:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-proot"]
      interval: 5s
      retries: 20
    networks: [lodev]

  mariadb:
    image: mariadb:11.4
    container_name: lodev-mariadb
    restart: unless-stopped
    environment:
      - MARIADB_ROOT_PASSWORD=root
    volumes:
      - lodev-mariadb:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      retries: 20
    ports:
      - "127.0.0.1:3307:3306"
    networks: [lodev]

  redis:
    image: redis:7-alpine
    container_name: lodev-redis
    restart: unless-stopped
    # The image declares VOLUME /data; without a named volume each recreate leaves an anonymous one.
    volumes:
      - lodev-redis:/data
    networks: [lodev]

  opensearch:
    image: opensearchproject/opensearch:2
    container_name: lodev-opensearch
    restart: unless-stopped
    environment:
      - discovery.type=single-node
      - DISABLE_SECURITY_PLUGIN=true
      - DISABLE_INSTALL_DEMO_CONFIG=true
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
    mem_limit: 2g
    volumes:
      - lodev-opensearch:/usr/share/opensearch/data
    networks: [lodev]

  mailpit:
    image: axllent/mailpit
    container_name: lodev-mailpit
    restart: unless-stopped
    labels:
      - traefik.enable=true
      - traefik.http.routers.mailpit.rule=Host(`mailpit.test`)
      - traefik.http.routers.mailpit.entrypoints=websecure
      - traefik.http.routers.mailpit.tls=true
      - traefik.http.services.mailpit.loadbalancer.server.port=8025
    networks: [lodev]

  phpmyadmin:
    image: phpmyadmin
    container_name: lodev-phpmyadmin
    restart: unless-stopped
    environment:
      - PMA_HOSTS=mysql,mariadb
      - PMA_USER=root
      - PMA_PASSWORD=root
    labels:
      - traefik.enable=true
      - traefik.http.routers.phpmyadmin.rule=Host(`phpmyadmin.test`)
      - traefik.http.routers.phpmyadmin.entrypoints=websecure
      - traefik.http.routers.phpmyadmin.tls=true
      - traefik.http.services.phpmyadmin.loadbalancer.server.port=80
    networks: [lodev]

  rabbitmq:
    image: rabbitmq:4-management
    container_name: lodev-rabbitmq
    restart: unless-stopped
    volumes:
      - lodev-rabbitmq:/var/lib/rabbitmq
    labels:
      - traefik.enable=true
      - traefik.http.routers.rabbitmq.rule=Host(`rabbitmq.test`)
      - traefik.http.routers.rabbitmq.entrypoints=websecure
      - traefik.http.routers.rabbitmq.tls=true
      - traefik.http.services.rabbitmq.loadbalancer.server.port=15672
    networks: [lodev]

  mongodb:
    image: mongo:8
    container_name: lodev-mongodb
    restart: unless-stopped
    environment:
      - MONGO_INITDB_ROOT_USERNAME=root
      - MONGO_INITDB_ROOT_PASSWORD=root
    volumes:
      - lodev-mongodb:/data/db
      - lodev-mongodb-config:/data/configdb
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      retries: 20
    networks: [lodev]

  mongo-express:
    image: mongo-express
    container_name: lodev-mongo-express
    restart: unless-stopped
    environment:
      - ME_CONFIG_MONGODB_URL=mongodb://root:root@mongodb:27017/
      - ME_CONFIG_MONGODB_ENABLE_ADMIN=true
      - ME_CONFIG_BASICAUTH_ENABLED=false
      - ME_CONFIG_BASICAUTH=false
    depends_on:
      mongodb:
        condition: service_healthy
    labels:
      - traefik.enable=true
      - traefik.http.routers.mongo-express.rule=Host(`mongo.test`)
      - traefik.http.routers.mongo-express.entrypoints=websecure
      - traefik.http.routers.mongo-express.tls=true
      - traefik.http.services.mongo-express.loadbalancer.server.port=8081
    networks: [lodev]
