# generated by lodev. Do NOT change anything
# Rewritten on every `lodev service start`: edit ~/.lodev/config.yaml instead.
name: lodev-services

networks:
  lodev:
    name: lodev
    ipam:
      config:
        - subnet: 172.30.0.0/16
          gateway: 172.30.0.1
          # Dynamic IPs stay out of 172.30.0.x, so traefik's fixed 172.30.0.2 is always free.
          ip_range: 172.30.128.0/17

volumes:
  lodev-mysql:
    name: lodev-mysql
  lodev-opensearch:
    name: lodev-opensearch
  lodev-redis:
    name: lodev-redis
  lodev-rabbitmq:
    name: lodev-rabbitmq
  lodev-mariadb:
    name: lodev-mariadb
  lodev-mongodb:
    name: lodev-mongodb
  # mongo also declares /data/configdb a volume; unnamed it would leave a new volume on every re-create.
  lodev-mongodb-config:
    name: lodev-mongodb-config

services:
  traefik:
    image: traefik:v3
    container_name: lodev-traefik
    restart: unless-stopped
    command:
      - --api.insecure=true
      - --ping=true
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network=lodev
      - --providers.file.filename=/certs/dynamic.yaml
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      # Keep a client's X-Forwarded-For (e.g. a spoofed IP to test GeoIP); traefik only listens on 127.0.0.1.
      - --entrypoints.websecure.forwardedHeaders.insecure=true
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
    ports:
      - "127.0.0.1:80:80"
      - "127.0.0.1:443:443"
      - "127.0.0.1:10999:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - "/home/u/.lodev/certs:/certs:ro"
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    networks:
      lodev:
        ipv4_address: 172.30.0.2

  mysql:
    image: mysql:8.0
    container_name: lodev-mysql
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=root
    volumes:
      - lodev-mysql:/var/lib/mysql
      - "/home/u/.lodev/services/mysql/lodev.cnf:/etc/mysql/conf.d/zz-lodev.cnf:ro"
    healthcheck:
      # Over TCP: the temporary server MySQL runs while initializing listens on the socket only.
      test: ["CMD-SHELL", "mysql -h127.0.0.1 -uroot -p\"$$MYSQL_ROOT_PASSWORD\" -e 'SHOW DATABASES;' >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    ports:
      - "127.0.0.1:3306:3306"
    networks: [lodev]

  mariadb:
    image: mariadb:11.4
    container_name: lodev-mariadb
    restart: unless-stopped
    environment:
      - MARIADB_ROOT_PASSWORD=root
    volumes:
      - lodev-mariadb:/var/lib/mysql
      - "/home/u/.lodev/services/mariadb/lodev.cnf:/etc/mysql/conf.d/zz-lodev.cnf:ro"
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    networks: [lodev]

  redis:
    image: redis:7-alpine
    container_name: lodev-redis
    restart: unless-stopped
    # The image declares VOLUME /data; without a named volume each recreate leaves an anonymous one.
    volumes:
      - lodev-redis:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    networks: [lodev]

  opensearch:
    # With analysis-icu and analysis-phonetic (Magento's Smile ElasticSuite needs them): they only add
    # analyzers, so projects that do not use them see no change. Built once per version by compose up.
    image: lodev/opensearch:2
    # Built here, never on a registry: without this compose tries Docker Hub first and warns.
    pull_policy: never
    build:
      dockerfile_inline: |
        FROM opensearchproject/opensearch:2
        RUN for plugin in analysis-icu analysis-phonetic; do opensearch-plugin install --batch $$plugin; done
    container_name: lodev-opensearch
    restart: unless-stopped
    environment:
      - discovery.type=single-node
      - DISABLE_SECURITY_PLUGIN=true
      - DISABLE_INSTALL_DEMO_CONFIG=true
      - OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
    mem_limit: 1g
    volumes:
      - lodev-opensearch:/usr/share/opensearch/data
    healthcheck:
      # One node: yellow (replicas unassigned) is as healthy as it gets.
      test: ["CMD-SHELL", "curl -fsS 'http://127.0.0.1:9200/_cluster/health?wait_for_status=yellow&timeout=5s' >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    networks: [lodev]

  mailpit:
    image: axllent/mailpit
    container_name: lodev-mailpit
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "/mailpit", "readyz"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    labels:
      - traefik.enable=true
      - traefik.http.routers.mailpit.rule=Host(`mailpit.test`)
      - traefik.http.routers.mailpit.entrypoints=websecure
      - traefik.http.routers.mailpit.tls=true
      - traefik.http.services.mailpit.loadbalancer.server.port=8025
    networks: [lodev]

  phpmyadmin:
    image: phpmyadmin
    container_name: lodev-phpmyadmin
    restart: unless-stopped
    environment:
      - PMA_HOSTS=mysql
      - PMA_USER=root
      - PMA_PASSWORD=root
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    depends_on:
      mysql:
        condition: service_healthy
    labels:
      - traefik.enable=true
      - traefik.http.routers.phpmyadmin.rule=Host(`phpmyadmin.test`)
      - traefik.http.routers.phpmyadmin.entrypoints=websecure
      - traefik.http.routers.phpmyadmin.tls=true
      - traefik.http.services.phpmyadmin.loadbalancer.server.port=80
    networks: [lodev]

  rabbitmq:
    image: rabbitmq:4-management
    container_name: lodev-rabbitmq
    restart: unless-stopped
    volumes:
      - lodev-rabbitmq:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    labels:
      - traefik.enable=true
      - traefik.http.routers.rabbitmq.rule=Host(`rabbitmq.test`)
      - traefik.http.routers.rabbitmq.entrypoints=websecure
      - traefik.http.routers.rabbitmq.tls=true
      - traefik.http.services.rabbitmq.loadbalancer.server.port=15672
    networks: [lodev]

  mongodb:
    image: mongo:8
    container_name: lodev-mongodb
    restart: unless-stopped
    environment:
      - MONGO_INITDB_ROOT_USERNAME=root
      - MONGO_INITDB_ROOT_PASSWORD=root
    volumes:
      - lodev-mongodb:/data/db
      - lodev-mongodb-config:/data/configdb
    healthcheck:
      # mongosh ships with mongo 5+, the legacy mongo shell with 4.4 and older.
      test: ["CMD-SHELL", "mongosh --quiet --eval \"db.adminCommand('ping')\" || mongo --quiet --eval \"db.adminCommand('ping')\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    networks: [lodev]

  mongo-express:
    image: mongo-express
    container_name: lodev-mongo-express
    restart: unless-stopped
    environment:
      - ME_CONFIG_MONGODB_URL=mongodb://root:root@mongodb:27017/
      - ME_CONFIG_MONGODB_ENABLE_ADMIN=true
      - ME_CONFIG_BASICAUTH_ENABLED=false
      - ME_CONFIG_BASICAUTH=false
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8081"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    depends_on:
      mongodb:
        condition: service_healthy
    labels:
      - traefik.enable=true
      - traefik.http.routers.mongo-express.rule=Host(`mongo.test`)
      - traefik.http.routers.mongo-express.entrypoints=websecure
      - traefik.http.routers.mongo-express.tls=true
      - traefik.http.services.mongo-express.loadbalancer.server.port=8081
    networks: [lodev]
