# Generated by lodev on every `lodev start` — edit .lodev/web-images/ instead.
FROM lodev/webserver:dev
RUN --mount=type=cache,target=/usr/local/n,sharing=locked N_PREFIX=/usr/local n install 20
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends php8.3-imagick vim
# --- .lodev/web-images/Dockerfile ---
RUN echo base
# --- .lodev/web-images/Dockerfile.redis ---
RUN echo redis
