# generated by lodev. Do NOT change anything
# Rewritten on every `lodev start`: edit .lodev/config.yaml instead.
name: lodev-shop

networks:
  lodev:
    external: true

services:
  web:
    image: lodev/shop-web
    container_name: lodev-shop-web
    hostname: shop-web
    # dockerd userns-remap would shift the container user's UID off the host's, so it could
    # not write the bind-mounted project and home; a no-op without remapping.
    userns_mode: host
    # Any user may bind :80/:443 (nginx, apache2 run by hand); scoped to the container's network.
    sysctls:
      net.ipv4.ip_unprivileged_port_start: 0
    restart: unless-stopped
    working_dir: "/app"
    # lodev start waits for this, and varnish too (a backend that fails its first probe starts sick).
    healthcheck:
      test: ["CMD", "/usr/local/bin/lodev-healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 2m
      start_interval: 1s
    environment:
      - "LODEV_PHP=8.3"
      - "LODEV_WEBSERVER=nginx"
      - "LODEV_USER=kuroko"
      - "LODEV_UID=501"
      - "LODEV_GID=20"
      - "LODEV_WORKDIR=/app"
      - "PHP_IDE_CONFIG=serverName=shop"
      - "DB_HOST=mysql"
      - "DB_PORT=3306"
      - "DB_DATABASE=shop"
      - "DB_USERNAME=root"
      - "DB_PASSWORD=root"
      - "REDIS_HOST=redis"
      - "OPENSEARCH_HOST=opensearch"
      - "MONGODB_URI=mongodb://root:root@mongodb:27017/?authSource=admin"
      - "MAIL_HOST=mailpit"
      - "MAIL_PORT=1025"
      - "HISTFILE=/var/lib/lodev/home/.bash_history"
      - "MYSQL_HISTFILE=/var/lib/lodev/home/.mysql_history"
      - "COMPOSER_CACHE_DIR=/var/lib/lodev/home/.cache/composer"
      - "npm_config_cache=/var/lib/lodev/home/.npm"
      - "YARN_CACHE_FOLDER=/var/lib/lodev/home/.cache/yarn"
      - "pnpm_config_store_dir=/var/lib/lodev/home/.local/share/pnpm/store"
      - "VARNISH_HOST=lodev-shop-varnish"
    networks: [lodev, default]
    # Every project's domains reach traefik, so one project can call another over https.
    extra_hosts:
      - "en.test:172.30.0.2"
      - "shop.test:172.30.0.2"
      - "mailpit.test:172.30.0.2"
      - "phpmyadmin.test:172.30.0.2"
    volumes:
      - "/work/shop:/app"
      - "/home/u/.lodev/rootCA/rootCA.pem:/etc/lodev/rootCA.pem:ro"
      - "/work/shop/.lodev/php:/etc/lodev/php.d:ro"
      - "/home/u/.lodev/data/home-shop:/var/lib/lodev/home"
      - "/home/u/.lodev/homeadditional:/etc/lodev/homeadditional/global:ro"
      - "/work/shop/.lodev/nginx-webserver.conf:/etc/lodev/webserver.conf:ro"
      - "/work/shop/.lodev/nginx:/etc/nginx/custom.d:ro"

  # Traefik → varnish:80 → web:80; the VCL is .lodev/varnish.vcl.
  varnish:
    image: varnish:9.1
    container_name: lodev-shop-varnish
    hostname: shop-varnish
    restart: unless-stopped
    depends_on:
      web:
        condition: service_healthy
        # varnishd resolves the backend once: recreate varnish when web is recreated.
        restart: true
    networks: [lodev, default]
    volumes:
      - "/work/shop/.lodev/varnish.vcl:/etc/varnish/default.vcl:ro"
