# lodev-generated: delete this line to manage this file yourself
server {
    listen 80;
    server_name _;
    # Traefik and Varnish (lodev or the project network): take the client from X-Forwarded-For.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 256m;
    include /etc/nginx/custom.d/*.conf;

    # Everything goes to the nextjs daemon's dev server, websockets included (HMR).
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # Next streams RSC/Suspense and sends no X-Accel-Buffering: pass chunks on as they come.
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300;
    }
}
