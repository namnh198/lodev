# Usage: dbeaver
# Description: Open the project's MySQL/MariaDB database in DBeaver (needs ports.mysql or ports.mariadb)
# Verified against https://dbeaver.com/docs/dbeaver/Command-Line/: -con "driver=...|host=...|port=...|database=...|user=...|password=...|name=...|connect=true"
# Limit: macOS passes --args only when the app is not already running: quit it first.
[ -n "$LODEV_PROJECT" ] || { echo "not in a lodev project"; exit 1; }
[ -n "$LODEV_DB_TYPE" ] || { echo "$LODEV_PROJECT has no MySQL/MariaDB service"; exit 1; }
if [ -z "$LODEV_DB_PORT" ]; then
  [ "$LODEV_DB_TYPE" = mariadb ] && { n=MariaDB p=3307; } || { n=MySQL p=3306; }
  echo "$n is not reachable from this machine: lodev config-global --$LODEV_DB_TYPE-port=$p, then lodev service start"
  exit 1
fi
con="driver=$LODEV_DB_TYPE|host=$LODEV_DB_HOST|port=$LODEV_DB_PORT|database=$LODEV_DB_NAME|user=$LODEV_DB_USER|password=$LODEV_DB_PASSWORD|name=lodev-$LODEV_PROJECT|connect=true"
case $(uname -s) in
  Darwin) open -a DBeaver --args -con "$con" ;;
  *) command -v dbeaver >/dev/null || { echo "dbeaver is not installed (install DBeaver and put dbeaver on PATH)"; exit 1; }
  dbeaver -con "$con" ;;
esac
